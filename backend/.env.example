APP_NAME=VendorHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.vendorhub.com

# --- White label branding ---
APP_TAGLINE="Multi-Vendor E-Commerce & Delivery Platform"
COMPANY_NAME="VendorHub Technologies Inc."
SUPPORT_EMAIL="support@vendorhub.com"
SUPPORT_PHONE="+1-800-VENDORHUB"
BRAND_PRIMARY_COLOR=#6366F1
BRAND_SECONDARY_COLOR=#EC4899
BRAND_ACCENT_COLOR=#F59E0B
BRAND_LOGO_URL=https://api.vendorhub.com/assets/logo.png

# --- Feature flags ---
FEATURE_VIDEO_COMMERCE=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_MULTI_BRANCH=true
FEATURE_THERMAL_PRINTING=true
FEATURE_DRIVER_EARNINGS=true
FEATURE_VENDOR_VERIFICATION=true
FEATURE_CUSTOMER_REVIEWS=true
FEATURE_LIVE_CHAT=false
FEATURE_LOYALTY_POINTS=false

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vendorhub
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / Queue ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_DRIVER=cookie

# --- Filesystem ---
FILESYSTEM_DRIVER=local
CDN_URL=

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- JWT Auth (multi-guard via firebase/php-jwt) ---
# REQUIRED. No fallback secret is configured; the auth layer fails closed if
# this is empty. Generate with:  php -r "echo bin2hex(random_bytes(64));"
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=1440
JWT_REFRESH_TTL=20160

# --- Brute-force / account lockout ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

PASSWORD_MIN_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_PHONE_VERIFICATION=false

# --- Payment gateways ---
DEFAULT_PAYMENT_GATEWAY=stripe
STRIPE_ENABLED=true
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# --- Notifications ---
DEFAULT_NOTIFICATION_CHANNEL=firebase
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS=
ONESIGNAL_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Maps ---
MAP_PROVIDER=openstreetmap
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
MAPBOX_ENABLED=false
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v11

# --- Business logic ---
PLATFORM_COMMISSION_RATE=15.0
DELIVERY_FEE_TYPE=distance
BASE_DELIVERY_FEE=5.0
PER_KM_RATE=0.5
MIN_ORDER_AMOUNT=10.0
MAX_DELIVERY_RADIUS=20
AUTO_ASSIGN_DRIVER=true
VENDOR_APPROVAL_REQUIRED=true
DRIVER_APPROVAL_REQUIRED=true

# --- Localization ---
DEFAULT_CURRENCY=USD
CURRENCY_SYMBOL=$
CURRENCY_POSITION=before
DECIMAL_SEPARATOR=.
THOUSAND_SEPARATOR=,
APP_LOCALE=en

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@vendorhub.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Social login ---
GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_LOGIN_ENABLED=true
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_LOGIN_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# --- API ---
API_RATE_LIMIT=60
